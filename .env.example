# Server
PORT=4000
NODE_ENV=development

# Database (plain PostgreSQL, no Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/streetwarecity?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Payments — active provider is swappable via this flag; each provider reads its own keys below.
PAYMENT_PROVIDER=bachs

BACHS_SECRET_KEY=
BACHS_PUBLIC_KEY=
BACHS_WEBHOOK_SECRET=

# Uncomment and fill in if/when a second provider is enabled.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# Email / SMS (SendByte)
SENDBYTE_API_KEY=
SENDBYTE_FROM_EMAIL=no-reply@streetwearcity.com

# CORS
CLIENT_ORIGIN=http://localhost:3000
