# Server
PORT=4000
NODE_ENV=development

# Database (plain PostgreSQL, no Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/streetwarecity?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Seeded admin login (prisma/seed.ts) — dev-only defaults if unset. Always
# override both in any shared/production environment.
SEED_ADMIN_EMAIL=admin@streetwearcity.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Payments — active provider is swappable via this flag; each provider reads its own keys below.
PAYMENT_PROVIDER=paystack

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Kept for reference / rollback — Bachs was the original provider before the
# switch to Paystack (see docs/decisions.md). Not currently active.
BACHS_SECRET_KEY=
BACHS_PUBLIC_KEY=
BACHS_WEBHOOK_SECRET=

# Email / SMS (SendByte)
SENDBYTE_API_KEY=
SENDBYTE_FROM_EMAIL=no-reply@streetwearcity.com

# Media storage (Cloudinary) — used for product image uploads in the admin panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CLIENT_ORIGIN=http://localhost:3000
